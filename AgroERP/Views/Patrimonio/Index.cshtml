@model AgroERP.ViewModels.Patrimonio.PatrimonioPanelVM
@{
    Layout = "~/Views/Shared/_LayoutContabilidad.cshtml";
    ViewData["Title"] = "Control Patrimonial, Mantenimiento y Bajas";
    var vigentes = Model.Activos.Where(a => a.Estado != "DadoDeBaja").ToList();
    var capitalizados = Model.Activos.Where(a => a.Estado == "Activo").ToList();
}

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Ok"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ENCABEZADO -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-tools text-success me-2"></i>Control Patrimonial de Activos Fijos</h5>
        <small class="text-muted">Traslados de ubicación y custodio, mantenimientos, mejoras capitalizables y bajas patrimoniales</small>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-primary btn-sm btn-abrir" data-bs-toggle="modal" data-bs-target="#modalTransferencia">
            <i class="bi bi-arrow-left-right me-1"></i>Trasladar
        </button>
        <button class="btn btn-outline-warning btn-sm btn-abrir" data-bs-toggle="modal" data-bs-target="#modalMantenimiento">
            <i class="bi bi-wrench-adjustable me-1"></i>Mantenimiento / Mejora
        </button>
        <button class="btn btn-outline-danger btn-sm btn-abrir" data-bs-toggle="modal" data-bs-target="#modalBaja">
            <i class="bi bi-x-octagon me-1"></i>Dar de Baja
        </button>
    </div>
</div>

<!-- TARJETAS RESUMEN -->
<div class="row g-3 mb-4">
    <div class="col-md">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <span class="text-muted small text-uppercase fw-semibold">Activos vigentes</span>
                <h4 class="fw-bold text-primary mt-1 mb-0">@Model.TotalActivosVigentes</h4>
                <small class="text-muted">En proceso o activos</small>
            </div>
        </div>
    </div>
    <div class="col-md">
        <div class="card border-0 shadow-sm h-100 border-start border-info border-4">
            <div class="card-body">
                <span class="text-muted small text-uppercase fw-semibold">Traslados del mes</span>
                <h4 class="fw-bold text-info mt-1 mb-0">@Model.TransferenciasMes</h4>
                <small class="text-muted">Cambios de ubicación / custodio</small>
            </div>
        </div>
    </div>
    <div class="col-md">
        <div class="card border-0 shadow-sm h-100 border-start border-warning border-4">
            <div class="card-body">
                <span class="text-muted small text-uppercase fw-semibold">Gasto mantenimiento (mes)</span>
                <h4 class="fw-bold text-warning mt-1 mb-0">S/ @Model.GastoMantenimientoMes.ToString("N2")</h4>
                <small class="text-muted">Cuenta 6341</small>
            </div>
        </div>
    </div>
    <div class="col-md">
        <div class="card border-0 shadow-sm h-100 border-start border-success border-4">
            <div class="card-body">
                <span class="text-muted small text-uppercase fw-semibold">Mejoras capitalizadas (mes)</span>
                <h4 class="fw-bold text-success mt-1 mb-0">S/ @Model.MejorasCapitalizadasMes.ToString("N2")</h4>
                <small class="text-muted">Cuenta 3331</small>
            </div>
        </div>
    </div>
    <div class="col-md">
        <div class="card border-0 shadow-sm h-100 bg-dark text-white">
            <div class="card-body">
                <span class="text-white-50 small text-uppercase fw-semibold">Dados de baja</span>
                <h4 class="fw-bold text-danger mt-1 mb-0">@Model.TotalDadosDeBaja</h4>
                <small class="text-white-50">Retirados del patrimonio</small>
            </div>
        </div>
    </div>
</div>

<!-- PESTAÑAS -->
<ul class="nav nav-tabs mb-0" role="tablist">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabActivos" type="button"><i class="bi bi-building-gear me-1"></i>Activos (@Model.Activos.Count)</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabTransferencias" type="button"><i class="bi bi-arrow-left-right me-1"></i>Traslados (@Model.Transferencias.Count)</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabMantenimientos" type="button"><i class="bi bi-wrench-adjustable me-1"></i>Mantenimientos (@Model.Mantenimientos.Count)</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabBajas" type="button"><i class="bi bi-x-octagon me-1"></i>Bajas (@Model.Bajas.Count)</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabHistorial" type="button"><i class="bi bi-clock-history me-1"></i>Últimos movimientos</button></li>
</ul>

<div class="tab-content card border-0 shadow-sm border-top-0 mb-4">
    <!-- TAB: ACTIVOS -->
    <div class="tab-pane fade show active" id="tabActivos">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Código</th>
                        <th>Activo</th>
                        <th>Ubicación</th>
                        <th>Custodio</th>
                        <th class="text-end">Costo</th>
                        <th class="text-end">Dep. Acum.</th>
                        <th class="text-end">Valor Neto</th>
                        <th class="text-center">Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Activos.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">
                                No hay activos fijos registrados. Lavado los da de alta en <a href="/Activos/Index">Activos y Depreciación</a>.
                            </td>
                        </tr>
                    }
                    @foreach (var a in Model.Activos)
                    {
                        var badge = a.Estado switch { "Activo" => "bg-success", "EnProceso" => "bg-warning text-dark", _ => "bg-secondary" };
                        <tr class="@(a.Estado == "DadoDeBaja" ? "text-muted" : "")">
                            <td class="font-monospace fw-semibold">@a.Codigo</td>
                            <td>@a.Nombre<small class="text-muted d-block">@a.Categoria</small></td>
                            <td class="small">@a.Ubicacion</td>
                            <td class="small">@a.Responsable</td>
                            <td class="text-end">S/ @a.CostoAdquisicion.ToString("N2")</td>
                            <td class="text-end text-danger">S/ @a.DepreciacionAcumulada.ToString("N2")</td>
                            <td class="text-end fw-bold">S/ @a.ValorNetoLibros.ToString("N2")</td>
                            <td class="text-center"><span class="badge @badge">@a.Estado</span></td>
                            <td class="text-end">
                                @if (a.Estado != "DadoDeBaja")
                                {
                                    <div class="d-inline-flex gap-1">
                                        <button type="button" class="btn btn-sm btn-outline-primary btn-abrir" title="Trasladar"
                                                data-bs-toggle="modal" data-bs-target="#modalTransferencia" data-activo="@a.Id">
                                            <i class="bi bi-arrow-left-right"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-warning btn-abrir" title="Mantenimiento / Mejora"
                                                data-bs-toggle="modal" data-bs-target="#modalMantenimiento" data-activo="@a.Id">
                                            <i class="bi bi-wrench-adjustable"></i>
                                        </button>
                                        @if (a.Estado == "Activo")
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger btn-abrir" title="Dar de baja"
                                                    data-bs-toggle="modal" data-bs-target="#modalBaja" data-activo="@a.Id">
                                                <i class="bi bi-x-octagon"></i>
                                            </button>
                                        }
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- TAB: TRASLADOS -->
    <div class="tab-pane fade" id="tabTransferencias">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Fecha</th>
                        <th>Activo</th>
                        <th>Origen → Destino</th>
                        <th>Custodio anterior → nuevo</th>
                        <th>Motivo</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Transferencias.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-3">Sin traslados registrados.</td></tr>
                    }
                    @foreach (var t in Model.Transferencias)
                    {
                        <tr>
                            <td class="small">@t.FechaTransferencia.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="font-monospace fw-semibold">@t.CodigoActivo</span><small class="text-muted d-block">@t.NombreActivo</small></td>
                            <td class="small">@t.ZonaOrigen <i class="bi bi-arrow-right text-primary"></i> @t.ZonaDestino</td>
                            <td class="small">@t.ResponsableAnterior <i class="bi bi-arrow-right text-primary"></i> @t.ResponsableNuevo</td>
                            <td class="small">@t.Motivo</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- TAB: MANTENIMIENTOS -->
    <div class="tab-pane fade" id="tabMantenimientos">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Fecha</th>
                        <th>Activo</th>
                        <th>Tipo</th>
                        <th>Proveedor</th>
                        <th>Descripción</th>
                        <th class="text-end">Costo</th>
                        <th>Asiento</th>
                        <th>Usuario</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Mantenimientos.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-3">Sin mantenimientos registrados.</td></tr>
                    }
                    @foreach (var m in Model.Mantenimientos)
                    {
                        var esMejora = m.Tipo == "MejoraCapitalizable";
                        <tr>
                            <td class="small">@m.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="font-monospace fw-semibold">@m.CodigoActivo</span><small class="text-muted d-block">@m.NombreActivo</small></td>
                            <td><span class="badge @(esMejora ? "bg-success" : m.Tipo == "Correctivo" ? "bg-danger" : "bg-info text-dark")">@m.Tipo</span></td>
                            <td class="small">@m.Proveedor</td>
                            <td class="small">@m.Descripcion</td>
                            <td class="text-end fw-bold">S/ @m.Costo.ToString("N2")</td>
                            <td class="small font-monospace">@(esMejora ? "3331 / 4654" : "6341 / 4212")</td>
                            <td class="small">@m.Usuario</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- TAB: BAJAS -->
    <div class="tab-pane fade" id="tabBajas">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Fecha</th>
                        <th>Activo</th>
                        <th>Motivo</th>
                        <th class="text-end">Costo histórico (3331)</th>
                        <th class="text-end">Dep. acumulada (3913)</th>
                        <th class="text-end">Valor neto (6551)</th>
                        <th>Usuario</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Bajas.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-3">Sin bajas registradas.</td></tr>
                    }
                    @foreach (var b in Model.Bajas)
                    {
                        <tr>
                            <td class="small">@b.FechaBaja.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="font-monospace fw-semibold">@b.CodigoActivo</span><small class="text-muted d-block">@b.NombreActivo</small></td>
                            <td><span class="badge bg-secondary">@b.MotivoBaja</span></td>
                            <td class="text-end">S/ @b.CostoHistorico.ToString("N2")</td>
                            <td class="text-end">S/ @b.DepreciacionAcumuladaAlRetiro.ToString("N2")</td>
                            <td class="text-end fw-bold text-danger">S/ @b.ValorNetoEnBaja.ToString("N2")</td>
                            <td class="small">@b.Usuario</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- TAB: HISTORIAL UNIFICADO -->
    <div class="tab-pane fade" id="tabHistorial">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Fecha</th>
                        <th>Activo</th>
                        <th>Movimiento</th>
                        <th>Detalle</th>
                        <th class="text-end">Monto</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.UltimosMovimientos.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-3">Aún no hay movimientos patrimoniales.</td></tr>
                    }
                    @foreach (var h in Model.UltimosMovimientos)
                    {
                        <tr>
                            <td class="small">@h.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="font-monospace fw-semibold">@h.CodigoActivo</td>
                            <td><span class="badge bg-light text-dark border">@h.TipoMovimiento</span></td>
                            <td class="small">@h.Detalle</td>
                            <td class="text-end small">@(h.Monto.HasValue ? "S/ " + h.Monto.Value.ToString("N2") : "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL: TRASLADO -->
<div class="modal fade" id="modalTransferencia" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="RegistrarTransferencia" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-arrow-left-right me-2"></i>Trasladar Activo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Activo</label>
                    <select name="ActivoFijoId" class="form-select sel-activo" required>
                        <option value="">-- Seleccione --</option>
                        @foreach (var a in vigentes)
                        {
                            <option value="@a.Id" data-zona="@a.ZonaUbicacionId" data-resp="@a.UsuarioResponsableId"
                                    data-ubic="@a.Ubicacion" data-respnom="@a.Responsable">@a.Codigo - @a.Nombre</option>
                        }
                    </select>
                    <small class="text-muted" id="infoActual">&nbsp;</small>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Zona de destino</label>
                        <select name="ZonaDestinoId" id="selZonaDestino" class="form-select" required>
                            @foreach (var z in Model.Zonas)
                            {
                                <option value="@z.Id">@z.Texto</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Nuevo custodio</label>
                        <select name="ResponsableNuevoId" id="selResponsable" class="form-select" required>
                            @foreach (var u in Model.Usuarios)
                            {
                                <option value="@u.Id">@u.Texto</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label fw-semibold">Motivo del traslado</label>
                    <input type="text" name="Motivo" class="form-control" maxlength="250" placeholder="Ej. Reasignación a campaña de cosecha" required />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Registrar Traslado</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: MANTENIMIENTO / MEJORA -->
<div class="modal fade" id="modalMantenimiento" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <form asp-action="RegistrarMantenimiento" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-wrench-adjustable me-2"></i>Registrar Mantenimiento o Mejora</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-2 mb-3">
                    <div class="col-md-7">
                        <label class="form-label fw-semibold">Activo</label>
                        <select name="ActivoFijoId" class="form-select sel-activo" id="selActivoMant" required>
                            <option value="">-- Seleccione --</option>
                            @foreach (var a in vigentes)
                            {
                                <option value="@a.Id" data-estado="@a.Estado">@a.Codigo - @a.Nombre (@a.Estado)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label fw-semibold">Tipo</label>
                        <select name="Tipo" id="selTipoMant" class="form-select" required>
                            <option value="Preventivo">Preventivo</option>
                            <option value="Correctivo">Correctivo</option>
                            <option value="MejoraCapitalizable">MejoraCapitalizable</option>
                        </select>
                    </div>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-md-7">
                        <label class="form-label fw-semibold">Proveedor del servicio</label>
                        <select name="ProveedorId" class="form-select" required>
                            <option value="">-- Seleccione --</option>
                            @foreach (var p in Model.Proveedores)
                            {
                                <option value="@p.Id">@p.Texto</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label fw-semibold">N° Factura proveedor</label>
                        <input type="text" name="NumeroFactura" class="form-control" maxlength="30" placeholder="Ej. F001-000845" required />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Descripción del servicio</label>
                    <input type="text" name="Descripcion" class="form-control" maxlength="250" placeholder="Ej. Cambio de aceite y filtros del tractor" required />
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Costo (S/)</label>
                        <input type="number" step="0.01" min="0.01" name="Costo" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Días de crédito</label>
                        <input type="number" min="0" max="365" name="DiasVencimiento" class="form-control" value="30" required />
                    </div>
                </div>
                <div class="alert alert-light border small mb-0" id="ayudaMant"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-warning">Registrar</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: BAJA -->
<div class="modal fade" id="modalBaja" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="RegistrarBaja" method="post" class="modal-content"
              onsubmit="return confirm('La baja es definitiva: el activo pasará a DadoDeBaja y se generará el asiento contable. ¿Continuar?');">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-danger"><i class="bi bi-x-octagon me-2"></i>Baja Patrimonial</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Activo (solo activos capitalizados)</label>
                    <select name="ActivoFijoId" class="form-select sel-activo" id="selActivoBaja" required>
                        <option value="">-- Seleccione --</option>
                        @foreach (var a in capitalizados)
                        {
                            <option value="@a.Id"
                                    data-costo="@a.CostoAdquisicion.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                    data-dep="@a.DepreciacionAcumulada.ToString(System.Globalization.CultureInfo.InvariantCulture)">@a.Codigo - @a.Nombre</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Motivo</label>
                    <select name="MotivoBaja" class="form-select" required>
                        <option value="Desuso">Desuso</option>
                        <option value="Retiro">Retiro</option>
                        <option value="Siniestro">Siniestro</option>
                    </select>
                </div>
                <table class="table table-sm table-bordered small mb-0">
                    <thead class="table-light">
                        <tr><th>Cuenta</th><th class="text-end">Debe</th><th class="text-end">Haber</th></tr>
                    </thead>
                    <tbody>
                        <tr><td>3913 Depreciación acumulada</td><td class="text-end" id="bjDep">0.00</td><td></td></tr>
                        <tr><td>6551 Costo neto de baja</td><td class="text-end" id="bjVnl">0.00</td><td></td></tr>
                        <tr><td>3331 Maquinaria y equipo</td><td></td><td class="text-end" id="bjCosto">0.00</td></tr>
                    </tbody>
                </table>
                <small class="text-muted">Vista previa del asiento que se generará.</small>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-danger">Confirmar Baja</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            // Preseleccionar el activo cuando se abre el modal desde la fila de la tabla
            document.querySelectorAll('.btn-abrir').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var modal = document.querySelector(btn.getAttribute('data-bs-target'));
                    var sel = modal.querySelector('.sel-activo');
                    sel.value = btn.getAttribute('data-activo') || '';
                    sel.dispatchEvent(new Event('change'));
                });
            });

            // Traslado: mostrar ubicación/custodio actuales y proponerlos por defecto
            var selTr = document.querySelector('#modalTransferencia .sel-activo');
            selTr.addEventListener('change', function () {
                var o = selTr.selectedOptions[0];
                var info = document.getElementById('infoActual');
                if (!o || !o.value) { info.innerHTML = '&nbsp;'; return; }
                info.textContent = 'Actual: ' + o.dataset.ubic + ' · Custodio: ' + o.dataset.respnom;
                document.getElementById('selZonaDestino').value = o.dataset.zona;
                document.getElementById('selResponsable').value = o.dataset.resp;
            });

            // Mantenimiento: explicar el tratamiento contable según el tipo
            var selTipo = document.getElementById('selTipoMant');
            var selActMant = document.getElementById('selActivoMant');
            function ayudaMant() {
                var ayuda = document.getElementById('ayudaMant');
                var o = selActMant.selectedOptions[0];
                if (selTipo.value === 'MejoraCapitalizable') {
                    ayuda.innerHTML = '<b>Mejora capitalizable:</b> aumenta el costo y el valor neto del activo. Asiento <b>3331 Maquinaria / 4654 Pasivo activo fijo</b> y cuenta por pagar tipo <b>ActivoFijo</b>.' +
                        (o && o.value && o.dataset.estado !== 'Activo' ? '<br><span class="text-danger">El activo debe estar en estado Activo para capitalizar una mejora.</span>' : '');
                } else {
                    ayuda.innerHTML = '<b>Mantenimiento ' + selTipo.value.toLowerCase() + ':</b> se reconoce como gasto. Asiento <b>6341 Mantenimiento / 4212 Facturas por pagar</b> y cuenta por pagar tipo <b>Mantenimiento</b>.';
                }
            }
            selTipo.addEventListener('change', ayudaMant);
            selActMant.addEventListener('change', ayudaMant);
            ayudaMant();

            // Baja: vista previa del asiento (Dep. acumulada + VNL = Costo)
            var selBaja = document.getElementById('selActivoBaja');
            selBaja.addEventListener('change', function () {
                var o = selBaja.selectedOptions[0];
                var costo = o && o.value ? parseFloat(o.dataset.costo) : 0;
                var dep = o && o.value ? parseFloat(o.dataset.dep) : 0;
                var vnl = Math.round((costo - dep) * 100) / 100;
                var f = function (x) { return x.toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); };
                document.getElementById('bjDep').textContent = f(dep);
                document.getElementById('bjVnl').textContent = f(vnl);
                document.getElementById('bjCosto').textContent = f(costo);
            });
        })();
    </script>
}
