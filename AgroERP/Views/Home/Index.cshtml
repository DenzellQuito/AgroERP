@{
    ViewData["Title"] = "Aplicaciones";
}

<style>
    body {
        background-color: #f4f6f9;
    }

    .module-card {
        border-radius: 12px;
        transition: all 0.2s ease-in-out;
        cursor: pointer;
        text-decoration: none;
        color: inherit;
        background-color: white;
    }

        .module-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
            color: #198754;
        }

    .icon-wrapper {
        font-size: 3rem;
        margin-bottom: 10px;
    }
</style>

<div class="row mb-4 align-items-center">
    <div class="col-md-8">
        <h2 class="fw-bold" style="color: #2c3e50;">Aplicaciones</h2>
        <p class="text-muted">Módulos principales del sistema AgroERP</p>
    </div>
</div>

<div class="row row-cols-2 row-cols-md-4 g-4">
    <!-- Tarjeta del Macroproceso LOGÍSTICA -->
    <div class="col">
        <a href="/Logistica/Dashboard" class="card module-card h-100 shadow-sm border-0 text-center p-3">
            <div class="icon-wrapper">🚚</div>
            <h6 class="fw-bold mb-1">Logística Integral</h6>
            <small class="text-muted">6 Submódulos</small>
        </a>
    </div>
</div>