<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mi Paraíso Gramadal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body>
    <!-- Barra superior básica para poder cerrar sesión -->
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand text-success fw-bold" href="/Home/Index">AgroERP</a>
                <div class="d-flex">
                    <span class="navbar-text me-3">Hola, Denzell.Admin</span>
                    <form method="post" action="/Account/Logout">
                        <button type="submit" class="btn btn-outline-danger btn-sm">Salir</button>
                    </form>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid">
        <main role="main" class="pb-3">
            <!-- ¡ESTA ES LA LÍNEA QUE FALTABA Y CAUSABA EL ERROR! -->
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>