@model AgroERP.ViewModels.Calidad.RegistrarRecepcionViewModel
@{
    ViewData["Title"] = "Registrar Recepción";
    Layout = "~/Views/Shared/_LayoutLogistica.cshtml";
}

<h2 class="mt-3">Registrar Recepción (3-Way Matching)</h2>
<hr />
<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="RegistrarRecepcion" method="post">
    <input type="hidden" asp-for="OrdenCompraId" />

    <div class="row mb-3">
        <div class="col-md-4">
            <label class="fw-bold">N° Guía del Proveedor</label>
            <input asp-for="GuiaProveedor" class="form-control" required />
            <span asp-validation-for="GuiaProveedor" class="text-danger"></span>
        </div>
    </div>

    <table class="table table-bordered">
        <thead class="table-secondary">
            <tr>
                <th>Artículo</th>
                <th>Cant. Pedida (OC)</th>
                <th>Cant. Guía (Prov.)</th>
                <th>Cant. Contada (Físico)</th>
                <th>N° Lote</th>
                <th>Fecha Vencimiento</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Detalles.Count; i++)
            {
                <tr>
                    <td>
                        @Model.Detalles[i].NombreArticulo
                        <input type="hidden" asp-for="Detalles[i].ArticuloId" />
                        <input type="hidden" asp-for="Detalles[i].NombreArticulo" />
                    </td>
                    <td>
                        <input asp-for="Detalles[i].CantidadPedida" class="form-control" readonly />
                    </td>
                    <td>
                        <input asp-for="Detalles[i].CantidadGuia" class="form-control" type="number" step="0.01" required />
                    </td>
                    <td>
                        <input asp-for="Detalles[i].CantidadRecibida" class="form-control" type="number" step="0.01" required />
                    </td>
                    <td>
                        <input asp-for="Detalles[i].NumeroLote" class="form-control" required />
                    </td>
                    <td>
                        <input asp-for="Detalles[i].FechaVencimiento" class="form-control" type="date" required />
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button type="submit" class="btn btn-success">Registrar y Enviar a Calidad</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>