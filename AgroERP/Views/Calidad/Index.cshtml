@model IEnumerable<AgroERP.ViewModels.Calidad.RecepcionListViewModel>
@{
    ViewData["Title"] = "Recepción";
    Layout = "~/Views/Shared/_LayoutLogistica.cshtml";
}

<h2 class="mt-3">Recepción de Mercadería</h2>
<hr />
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning">@TempData["Warning"]</div>
}

<table class="table table-striped">
    <thead class="table-dark">
        <tr>
            <th>OC #</th>
            <th>Proveedor</th>
            <th>Total</th>
            <th>Acción</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.OrdenCompraId</td>
                <td>@item.Proveedor</td>
                <td>@item.Total.ToString("C")</td>
                <td>
                    <a asp-action="RegistrarRecepcion" asp-route-id="@item.OrdenCompraId" class="btn btn-sm btn-primary">Recibir Orden</a>
                </td>
            </tr>
        }
    </tbody>
</table>