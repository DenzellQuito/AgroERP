@model IEnumerable<AgroERP.ViewModels.Calidad.RecepcionListViewModel>
@{
    ViewData["Title"] = "Recepción";
    Layout = "~/Views/Shared/_LayoutLogistica.cshtml";
    var recientes = ViewBag.RecepcionesRecientes as List<AgroERP.ViewModels.Calidad.RecepcionHistorialItemVM> ?? new();
}

<h2 class="mt-3">Recepción de Mercadería</h2>
<hr />
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning">@TempData["Warning"]</div>
}

<h5 class="mb-2">Órdenes de Compra Pendientes de Recepción</h5>
<table class="table table-striped mb-4">
    <thead class="table-dark">
        <tr>
            <th>OC #</th>
            <th>Proveedor</th>
            <th>Total</th>
            <th>Acción</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="4" class="text-center text-muted py-3">No hay órdenes de compra pendientes de recepción.</td></tr>
        }
        @foreach (var item in Model)
        {
            <tr>
                <td>OC-@item.OrdenCompraId.ToString("D4")</td>
                <td>@item.Proveedor</td>
                <td>@item.Total.ToString("C")</td>
                <td>
                    <a asp-action="RegistrarRecepcion" asp-route-id="@item.OrdenCompraId" class="btn btn-sm btn-primary">Recibir Orden</a>
                    <a asp-controller="Compras" asp-action="GenerarPdf" asp-route-id="@item.OrdenCompraId" target="_blank" class="btn btn-sm btn-outline-danger ms-1">📄 Ver OC PDF</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<h5 class="mt-4 mb-2">Historial de Recepciones y Reportes de Calidad</h5>
<table class="table table-hover table-bordered align-middle">
    <thead class="table-secondary">
        <tr>
            <th>Recepción</th>
            <th>OC #</th>
            <th>Proveedor</th>
            <th>Guía Proveedor</th>
            <th>Fecha</th>
            <th>Estado</th>
            <th>Documentos</th>
        </tr>
    </thead>
    <tbody>
        @if (!recientes.Any())
        {
            <tr><td colspan="7" class="text-center text-muted py-3">Todavía no hay recepciones registradas.</td></tr>
        }
        @foreach (var r in recientes)
        {
            <tr>
                <td class="fw-bold">REC-@r.RecepcionId.ToString("D4")</td>
                <td>OC-@r.OrdenCompraId.ToString("D4")</td>
                <td>@r.Proveedor</td>
                <td>@r.GuiaProveedor</td>
                <td>@r.FechaRecepcion.ToString("dd/MM/yyyy HH:mm")</td>
                <td><span class="badge @(r.Estado == "Cerrada" ? "bg-success" : "bg-warning text-dark")">@r.Estado</span></td>
                <td>
                    <a asp-action="ReporteRecepcionPdf" asp-route-id="@r.RecepcionId" target="_blank" class="btn btn-sm btn-danger">📄 Reporte Calidad PDF</a>
                    <a asp-controller="Compras" asp-action="GenerarPdf" asp-route-id="@r.OrdenCompraId" target="_blank" class="btn btn-sm btn-outline-secondary ms-1">📄 Ver OC PDF</a>
                </td>
            </tr>
        }
    </tbody>
</table>