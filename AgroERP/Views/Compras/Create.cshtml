@{
    ViewData["Title"] = "Nuevo Requerimiento";
    Layout = "~/Views/Shared/_LayoutLogistica.cshtml";
}

<div class="container mt-4">
    <h2 class="mb-3">Crear Requerimiento de Compra</h2>

    <div class="card shadow-sm" style="max-width: 600px;">
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label class="form-label fw-bold">Seleccionar Artículo</label>
                    <select name="articuloId" class="form-select" required>
                        <option value="">-- Seleccione un artículo --</option>
                        @foreach (var art in ViewBag.Articulos)
                        {
                            <option value="@art.Id">@art.Codigo - @art.Nombre</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Cantidad Solicitada</label>
                    <input type="number" name="cantidad" class="form-control" step="0.01" min="1" required />
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a href="@Url.Action("Index")" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-success">Guardar Borrador</button>
                </div>
            </form>
        </div>
    </div>
</div>