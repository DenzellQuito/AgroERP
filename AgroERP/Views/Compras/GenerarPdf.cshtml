@model AgroERP.ViewModels.Compras.OrdenCompraImpresionViewModel

@{
    Layout = "~/Views/Shared/_LayoutDocumentoPdf.cshtml";
    ViewData["Title"] = "Orden de Compra";
    ViewData["CodigoDocumento"] = $"OC-{Model.Id:D4}";
    ViewData["SubtituloDocumento"] = $"Emitida el {Model.FechaEmision}";
}

<div class="row mb-4">
    <div class="col-sm-6">
        <h6 class="fw-bold text-secondary text-uppercase small">Datos del Proveedor</h6>
        <div class="border rounded p-3 bg-light">
            <div><strong>Razón Social:</strong> @Model.ProveedorRazonSocial</div>
            <div><strong>RUC:</strong> @Model.ProveedorRuc</div>
        </div>
    </div>
    <div class="col-sm-6">
        <h6 class="fw-bold text-secondary text-uppercase small">Condiciones Comerciales</h6>
        <div class="border rounded p-3 bg-light">
            <div><strong>Fecha de Emisión:</strong> @Model.FechaEmision</div>
            <div><strong>Moneda:</strong> Soles (PEN - S/)</div>
        </div>
    </div>
</div>

<table class="table table-bordered align-middle mb-4">
    <thead class="table-light">
        <tr>
            <th>Código</th>
            <th>Descripción</th>
            <th class="text-end">Cantidad</th>
            <th class="text-end">P. Unitario</th>
            <th class="text-end">Subtotal</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Detalles)
        {
            <tr>
                <td class="font-monospace">@item.Codigo</td>
                <td>@item.Descripcion</td>
                <td class="text-end">@item.Cantidad.ToString("N2")</td>
                <td class="text-end">S/ @item.PrecioUnitario.ToString("N4")</td>
                <td class="text-end fw-semibold">S/ @item.Subtotal.ToString("N2")</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr class="table-light">
            <th colspan="4" class="text-end fs-5">TOTAL ORDEN DE COMPRA:</th>
            <th class="text-end fs-5 text-primary">S/ @Model.Total.ToString("N2")</th>
        </tr>
    </tfoot>
</table>

<div class="row mt-5 pt-4 text-center">
    <div class="col-6">
        <div class="border-top mx-4 pt-2 small text-muted">Jefatura de Compras y Abastecimiento</div>
    </div>
    <div class="col-6">
        <div class="border-top mx-4 pt-2 small text-muted">Gerencia / Autorización</div>
    </div>
</div>