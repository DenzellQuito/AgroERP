@model AgroERP.ViewModels.Compras.FleteViewModel

@{
    ViewData["Title"] = "Registrar Gasto de Flete";
    Layout = "~/Views/Shared/_LayoutLogistica.cshtml";
}

<div class="container mt-4">
    <h2 class="mb-3">Registrar Flete para OC-@Model.OrdenCompraId.ToString("D4")</h2>

    <div class="alert alert-info">
        <strong>Integración Automática:</strong> Al guardar este formulario, el sistema generará automáticamente un asiento contable en el Libro Diario afectando la cuenta 6311 (Fletes) y 4212 (Cuentas por Pagar).
    </div>

    <div class="card shadow-sm" style="max-width: 600px;">
        <div class="card-body">
            <form asp-action="RegistrarFlete" method="post" id="frmFlete">
                <input type="hidden" asp-for="OrdenCompraId" />

                <div class="mb-3">
                    <label class="form-label fw-bold">Descripción / Glosa</label>
                    <input type="text" asp-for="Glosa" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Costo Total del Flete (S/)</label>
                    <input type="number" asp-for="CostoFlete" class="form-control" step="0.01" min="1" required />
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a href="@Url.Action("Ordenes")" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" id="btnGuardarFlete" class="btn btn-success">Guardar y Contabilizar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Ahora busca exactamente por el ID del formulario
    document.getElementById("frmFlete").addEventListener("submit", function() {
        var btn = document.getElementById("btnGuardarFlete");

        // El setTimeout(..., 10) asegura que el form arranque su envío antes de bloquear el botón visualmente
        setTimeout(function() {
            btn.disabled = true;
            btn.innerHTML = "Guardando...";
        }, 10);
    });
</script>