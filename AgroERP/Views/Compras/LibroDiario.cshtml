@model IEnumerable<AgroERP.ViewModels.Compras.AsientoDiarioViewModel>

@{
    ViewData["Title"] = "Libro Diario";
    Layout = "~/Views/Shared/_LayoutContabilidad.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Libro Diario (Solo Lectura)</h2>
        <a asp-action="LibroDiarioPdf" target="_blank" class="btn btn-danger">
            <i class="bi bi-file-earmark-pdf-fill me-1"></i>Exportar Libro Diario PDF
        </a>
    </div>

    @foreach (var asiento in Model)
    {
        string? urlOrigen = asiento.ReferenciaModulo switch
        {
            "Compras" when asiento.ReferenciaId.HasValue => Url.Action("GenerarPdf", "Compras", new { id = asiento.ReferenciaId }),
            "Recepcion" when asiento.ReferenciaId.HasValue => Url.Action("ReporteRecepcionPdf", "Calidad", new { id = asiento.ReferenciaId }),
            "Merma" => Url.Action("Index", "Almacen"),
            "Factura" when asiento.ReferenciaId.HasValue => Url.Action("FacturaPdf", "Distribucion", new { id = asiento.ReferenciaId }),
            "NotaCredito" when asiento.ReferenciaId.HasValue => Url.Action("NotaCreditoPdf", "Distribucion", new { id = asiento.ReferenciaId }),
            "Cobranza" => Url.Action("Index", "Cobranza"),
            "Pagos" => Url.Action("Index", "Pagos"),
            "Conciliacion" when asiento.ReferenciaId.HasValue => Url.Action("Conciliar", "Tesoreria", new { id = asiento.ReferenciaId }),
            "Tesoreria" => Url.Action("Index", "Tesoreria"),
            "AltaActivo" or "Depreciacion" or "MantenimientoActivo" or "MejoraActivo" when asiento.ReferenciaId.HasValue => Url.Action("FichaPdf", "Activos", new { id = asiento.ReferenciaId }),
            "BajaActivo" => Url.Action("Index", "Patrimonio"),
            _ => null
        };

        <div class="card shadow-sm mb-4 border-primary">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <strong>Asiento #@asiento.Id.ToString("D4") | @asiento.Referencia</strong>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="small">@asiento.Fecha</span>
                    @if (!string.IsNullOrEmpty(urlOrigen))
                    {
                        <a href="@urlOrigen" target="_blank" class="btn btn-sm btn-light text-dark fw-semibold">
                            <i class="bi bi-box-arrow-up-right me-1"></i>Ver Documento Origen
                        </a>
                    }
                    <a asp-action="LibroDiarioPdf" asp-route-asientoId="@asiento.Id" target="_blank" class="btn btn-sm btn-warning text-dark fw-semibold">
                        <i class="bi bi-file-earmark-pdf me-1"></i>Voucher PDF
                    </a>
                </div>
            </div>
            <div class="card-body py-2 bg-light">
                <p class="mb-2 text-muted"><em>Glosa: @asiento.Glosa</em></p>
                <table class="table table-sm table-bordered bg-white mb-0">
                    <thead class="table-secondary text-center">
                        <tr>
                            <th class="text-start">Cuenta Contable</th>
                            <th style="width: 15%">Debe (S/)</th>
                            <th style="width: 15%">Haber (S/)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detalle in asiento.Detalles)
                        {
                            <tr>
                                <td>@detalle.Cuenta</td>
                                <td class="text-end text-success">@(detalle.Debe > 0 ? detalle.Debe.ToString("0.00") : "")</td>
                                <td class="text-end text-danger">@(detalle.Haber > 0 ? detalle.Haber.ToString("0.00") : "")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="fw-bold bg-light">
                        <tr>
                            <td class="text-end">TOTALES:</td>
                            <td class="text-end">@asiento.Detalles.Sum(d => d.Debe).ToString("0.00")</td>
                            <td class="text-end">@asiento.Detalles.Sum(d => d.Haber).ToString("0.00")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
</div>