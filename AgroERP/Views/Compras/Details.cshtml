@model AgroERP.ViewModels.Compras.RequerimientoDetalleViewModel

@{
    ViewData["Title"] = "Detalles del Requerimiento";
    Layout = "~/Views/Shared/_LayoutLogistica.cshtml";
}

<div class="container mt-4">
    @if (TempData["Ok"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">@TempData["Ok"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Requerimiento: REQ-@Model.Id.ToString("D4")</h2>
        <span class="badge @(Model.Estado == "Borrador" ? "bg-secondary fs-6" : Model.Estado == "Aprobado" ? "bg-success fs-6" : Model.Estado == "Rechazado" ? "bg-danger fs-6" : "bg-warning text-dark fs-6")">
            @Model.Estado
        </span>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light fw-bold">
            Información General
        </div>
        <div class="card-body">
            <p class="mb-1"><strong>Fecha de Solicitud:</strong> @Model.FechaSolicitud</p>
            <p class="mb-0"><strong>Solicitante:</strong> @Model.Solicitante</p>
        </div>
    </div>

    <h4 class="mb-3">Artículos Solicitados</h4>
    <table class="table table-bordered table-striped shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Código</th>
                <th>Descripción</th>
                <th class="text-end">Cantidad</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Articulos)
            {
                <tr>
                    <td>@item.CodigoArticulo</td>
                    <td>@item.NombreArticulo</td>
                    <td class="text-end">@item.Cantidad.ToString("0.00")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mt-4 d-flex gap-2">
        <a href="@Url.Action("Index")" class="btn btn-secondary">Volver a la lista</a>
        @if (Model.Estado != "Rechazado")
        {
            <a href="@Url.Action("Cotizaciones", new { id = Model.Id })" class="btn btn-info">Ver Cotizaciones</a>
        }
        @if (Model.Estado == "Borrador")
        {
            <form asp-action="EnviarAprobacion" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-primary">Enviar a Aprobación</button>
            </form>
        }
        else if (Model.Estado == "PendienteAprobacion")
        {
            <form asp-action="AprobarRequerimiento" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-success">Aprobar Requerimiento</button>
            </form>
            <form asp-action="DevolverABorrador" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-warning">Solicitar Corrección (Borrador)</button>
            </form>
            <form asp-action="RechazarRequerimiento" method="post" class="d-inline" onsubmit="return confirm('¿Rechazar este requerimiento?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-danger">Rechazar</button>
            </form>
        }
    </div>

</div>