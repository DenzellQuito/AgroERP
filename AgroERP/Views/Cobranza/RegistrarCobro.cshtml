@{
    ViewData["Title"] = "Registrar Cobro";
    Layout = "~/Views/Shared/_LayoutContabilidad.cshtml";
    var cxc = ViewBag.CxC as AgroERP.Models.Tesoreria.CuentaPorCobrar;
    var notas = ViewBag.NotasCredito as List<AgroERP.Models.Distribucion.NotaCredito> ?? new();
}

@if (cxc == null)
{
    <div class="alert alert-danger mt-4">
        <h4>Error</h4>
        <p>No se pudo cargar la información de la cuenta por cobrar. Por favor, regrese a la bandeja e intente de nuevo.</p>
        <a asp-action="Index" class="btn btn-secondary">Volver a la Bandeja</a>
    </div>
    return;
}

<div class="d-flex justify-content-between align-items-center mt-3 mb-4">
    <h2>Registrar Cobro</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Volver a la Bandeja
    </a>
</div>

@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning">@TempData["Warning"]</div>
}

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">

                <div class="alert alert-info">
                    <div class="d-flex justify-content-between align-items-start">
                        <h5 class="alert-heading mb-0">Resumen de la Deuda</h5>
                        <a asp-controller="Distribucion" asp-action="FacturaPdf" asp-route-id="@cxc.ComprobantePagoId" target="_blank" class="btn btn-sm btn-outline-danger">
                            📄 Ver Factura F001-@cxc.ComprobantePagoId.ToString("D6")
                        </a>
                    </div>
                    <hr>
                    <p class="mb-1"><strong>Cliente:</strong> @cxc.Cliente.RazonSocial</p>
                    <p class="mb-1"><strong>Total Facturado:</strong> @cxc.MontoTotal.ToString("C")</p>
                    <p class="mb-0 fw-bold text-danger"><strong>Saldo Pendiente:</strong> @cxc.SaldoPendiente.ToString("C")</p>
                </div>

                <form asp-action="RegistrarCobro" method="post">
                    <!-- ID oculto de la Cuenta por Cobrar -->
                    <input type="hidden" name="cuentaPorCobrarId" value="@cxc.Id" />

                    <div class="form-group mb-3">
                        <label class="fw-bold">Monto a Cobrar (S/)</label>
                        <input name="monto" class="form-control" type="number" step="0.01" max="@cxc.SaldoPendiente" value="@cxc.SaldoPendiente.ToString("F2")" required />
                        <small class="text-muted">El monto no puede superar el saldo pendiente.</small>
                    </div>

                    <div class="form-group mb-3">
                        <label class="fw-bold">Cuenta Bancaria (Destino)</label>
                        <select name="cuentaBancariaId" class="form-select" asp-items="ViewBag.CuentaBancariaId" required>
                            <option value="">-- Seleccione la cuenta del banco --</option>
                        </select>
                    </div>

                    <div class="form-group mb-3">
                        <label class="fw-bold">Medio de Pago</label>
                        <select name="medioPago" class="form-select" required>
                            <option value="Transferencia">Transferencia</option>
                            <option value="Deposito">Depósito</option>
                            <option value="POS">POS</option>
                        </select>
                    </div>

                    <div class="form-group mb-4">
                        <label class="fw-bold">N° de Operación / Voucher</label>
                        <input name="nroOperacion" class="form-control" placeholder="Ej: 458921" required />
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="bi bi-check-circle"></i> Confirmar Cobro
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>

    <div class="col-md-6">
        @if (notas.Any())
        {
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-warning-subtle fw-bold">Notas de Crédito Aplicadas</div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead><tr><th>N° NC</th><th>Fecha</th><th class="text-end">Monto</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var nc in notas)
                            {
                                <tr>
                                    <td class="font-monospace">NC01-@nc.Id.ToString("D6")</td>
                                    <td>@nc.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end text-danger fw-bold">- S/ @nc.Monto.ToString("N2")</td>
                                    <td class="text-end">
                                        <a asp-controller="Distribucion" asp-action="NotaCreditoPdf" asp-route-id="@nc.Id" target="_blank" class="btn btn-sm btn-outline-secondary">📄 PDF</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (cxc.Cobranzas.Any())
        {
            <div class="card shadow-sm">
                <div class="card-header bg-success-subtle fw-bold">Cobros Registrados Previamente</div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead><tr><th>Fecha</th><th>Banco</th><th>Op.</th><th class="text-end">Monto</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var cb in cxc.Cobranzas.OrderByDescending(x => x.FechaCobro))
                            {
                                <tr>
                                    <td>@cb.FechaCobro.ToString("dd/MM/yyyy")</td>
                                    <td class="small">@cb.CuentaBancaria.Banco</td>
                                    <td class="font-monospace small">@cb.NumeroOperacion</td>
                                    <td class="text-end text-success fw-bold">S/ @cb.MontoCobrado.ToString("N2")</td>
                                    <td class="text-end">
                                        <a asp-action="ReciboCobranzaPdf" asp-route-id="@cb.Id" target="_blank" class="btn btn-sm btn-outline-success">📄 Recibo</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>