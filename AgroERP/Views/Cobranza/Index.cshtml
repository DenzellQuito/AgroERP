@model List<AgroERP.ViewModels.Cobranzas.CuentaPorCobrarItemVM>
@{
    Layout = "~/Views/Shared/_LayoutContabilidad.cshtml";
    ViewData["Title"] = "Cuentas por Cobrar y Cobranzas";
}

<div class="d-flex justify-content-between align-items-center mt-3 mb-4">
    <h2>Bandeja de Cuentas por Cobrar</h2>
    <a asp-action="AntiguedadSaldosPdf" target="_blank" class="btn btn-danger">
        <i class="bi bi-file-earmark-pdf-fill me-1"></i>Antigüedad de Saldos PDF
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning">@TempData["Warning"]</div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Cliente</th>
                    <th>Vencimiento</th>
                    <th>Total</th>
                    <th>Saldo Pend.</th>
                    <th>Estado</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        bool estaVencida = DateTime.Now > item.FechaVencimiento && item.SaldoPendiente > 0;

                        <tr>
                            <td>@item.Cliente</td>
                            <td>
                                @item.FechaVencimiento.ToShortDateString()
                                @if (estaVencida)
                                {
                                    <span class="badge bg-danger ms-2">Vencida</span>
                                }
                            </td>
                            <td>@item.MontoTotal.ToString("C")</td>
                            <td class="fw-bold text-danger">@item.SaldoPendiente.ToString("C")</td>
                            <td>
                                <span class="badge @(item.Estado == "Pendiente" ? "bg-warning text-dark" : (item.Estado == "Cobrado" ? "bg-success" : "bg-info"))">
                                    @item.Estado
                                </span>
                            </td>
                            <td>
                                <div class="d-flex flex-wrap gap-1">
                                    @if (item.SaldoPendiente > 0)
                                    {
                                        <a asp-action="RegistrarCobro" asp-route-id="@item.Id" class="btn btn-sm btn-primary">
                                            <i class="bi bi-cash-coin"></i> Cobrar
                                        </a>
                                    }
                                    <a asp-controller="Distribucion" asp-action="FacturaPdf" asp-route-id="@item.ComprobantePagoId" target="_blank" class="btn btn-sm btn-outline-danger" title="Ver Factura PDF">
                                        📄 Factura
                                    </a>
                                    @if (item.UltimaNotaCreditoId.HasValue)
                                    {
                                        <a asp-controller="Distribucion" asp-action="NotaCreditoPdf" asp-route-id="@item.UltimaNotaCreditoId" target="_blank" class="btn btn-sm btn-outline-warning text-dark" title="Ver Nota de Crédito PDF">
                                            📄 NC
                                        </a>
                                    }
                                    @if (item.UltimaCobranzaId.HasValue)
                                    {
                                        <a asp-action="ReciboCobranzaPdf" asp-route-id="@item.UltimaCobranzaId" target="_blank" class="btn btn-sm btn-outline-success" title="Ver último Recibo de Cobranza PDF">
                                            📄 Recibo
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No hay cuentas por cobrar registradas.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>